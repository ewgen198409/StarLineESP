<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:padding="12dp"
    android:layout_margin="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hand_free_message"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnRssi70"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hand_free_70"
        android:background="#333333"
        android:textColor="#00FF00"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnRssi80"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hand_free_80"
        android:background="#333333"
        android:textColor="#FFFF00"
        android:layout_marginBottom="6dp" />

    <Button
        android:id="@+id/btnRssi90"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hand_free_90"
        android:background="#333333"
        android:textColor="#FF8800"
        android:layout_marginBottom="6dp" />

</LinearLayout>